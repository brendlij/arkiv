    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }

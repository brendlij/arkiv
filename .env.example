# Copy to .env. Paths are on the Docker host; create them before starting.
ARKIV_IMAGE=ghcr.io/brendlij/arkiv:latest
ARKIV_PHOTOS_DIR=/volume1/photos_arkiv
ARKIV_DATA_DIR=./data
ARKIV_CACHE_DIR=./cache

# Browser URL: http://YOUR-SERVER-IP:8090
ARKIV_HOST_PORT=8090
TZ=Europe/Berlin

# Seeds the FIRST account only. Change existing passwords inside the app.
# Generate: docker run --rm -i ghcr.io/brendlij/arkiv:latest hash-password
# Paste the whole result in single quotes to preserve its dollar signs.
ARKIV_USERNAME=admin
ARKIV_PASSWORD_HASH=''

# Set true when accessing arkiv through HTTPS.
ARKIV_SECURE_COOKIES=false

ARKIV_SCAN_ON_START=true
ARKIV_SCAN_INTERVAL=30m
ARKIV_WORKERS=2
ARKIV_UPLOAD_DIR=/photos/originals
# Arkiv account quota, not physical NAS free space. Admins can override it per account.
ARKIV_UPLOAD_QUOTA_BYTES=5368709120
# Incomplete uploads expire after seven days.
ARKIV_UPLOAD_RETENTION=168h
